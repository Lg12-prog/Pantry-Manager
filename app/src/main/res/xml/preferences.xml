<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <SwitchPreferenceCompat
        app:defaultValue="true"
        app:key="pref_expiry_alerts"
        app:summary="@string/pref_expiry_alerts_summary"
        app:title="@string/pref_expiry_alerts_title" />

    <ListPreference
        app:defaultValue="metric"
        app:entries="@array/units_entries"
        app:entryValues="@array/units_values"
        app:key="pref_units"
        app:title="@string/pref_units_title"
        app:useSimpleSummaryProvider="true" />

</PreferenceScreen>
